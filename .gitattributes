# Keep the shared world seed as pure LF everywhere. It's generated pure-LF by
# scripts/export-seed.mjs; without this, autocrlf would rewrite it to CRLF on
# Windows checkout, and the mixed line endings defeat content:publish's
# change-detection (spurious "Update world seed" commits).
db/seed.sql text eol=lf

# audio-seed.sql is ~15 MB of base64 sample blobs + tracker JSON (the audio half of
# the world snapshot, split out of seed.sql so content diffs stay readable). Keep it
# pure LF like seed.sql, but suppress diffs — rendering a 15 MB single-line change is
# useless noise and slow. It changes only when audio content actually changes.
db/audio-seed.sql text eol=lf -diff

# Content pipeline files (one JSON file per world entity, git-as-source-of-truth).
# Generated pure-LF with canonical serialization by scripts/content/export.mjs;
# byte-identity across machines is what makes exports and merge conflicts sane,
# so never let autocrlf touch them. audio_samples carry one-line base64 blobs —
# same -diff treatment as audio-seed.sql.
content/**/*.json text eol=lf
content/audio_samples/*.json text eol=lf -diff
