  "chitchat": [
    "\"Read the label. I know you won't. Read it anyway.\"",
    "counts tablets into a tray with a flat blade, five at a time, without appearing to count",
    "\"That'll sting. That's the sting doing its job, not the sting being a problem.\"",
    "writes something on a card, reads it back, and writes it out again more legibly",
    "\"I can sell you the cheap ones. I'd rather sell you the ones that work, but I can sell you the cheap ones.\""
  ],
  "description": "A tall woman with reading glasses pushed up into grey hair and the specific calm of somebody who has heard worse this morning. She dispenses from drawers labelled in a Latin that stopped describing the contents decades ago, and she has never once been wrong about which drawer.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"Right you are.\""
    },
    "root": {
      "options": [
        {
          "label": "Let's see what you've got.",
          "next": "__shop__"
        },
        {
          "label": "Another time.",
          "next": "bye"
        }
      ],
      "text": [
        "She does not stop what she is doing. \"With you in a moment.\" She is, in a moment.",
        "\"Right.\" The tray goes down. \"What have you done to yourself?\""
      ],
      "text_by_relation": {
        "familiar": "\"Sit down before you tell me.\" She indicates the chair by the door, the one that gets used.",
        "first": "\"Perpetua Lisk.\" She looks at you over the top of the glasses she is not wearing. \"Whatever it is, I have probably got something for it, and if I have not I will tell you that instead of selling you something else.\"",
        "known": "\"You again. Nothing serious, I hope.\" She has already decided whether it is serious."
      }
    }
  },
