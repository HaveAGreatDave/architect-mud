    "tv_lines": {
      "sports": [
        "\"Go on. Go on! Oh, for crying out loud.\"",
        "leans forward in the armchair with both hands on his knees.",
        "\"That's a ball. That was a ball from here, and I'm four miles away.\"",
        "\"Good. Now do it again.\"",
        "\"If that's a Crow I don't want to hear it.\"",
        "claps once, hard, and sits back grinning.",
        "\"I've been watching this club longer than that boy's been alive.\""
      ]
    },
    "alarm_lines": {
      "wake": [
        "sits up in bed and gropes on the side table for his glasses."
      ],
      "notice": [
        "\"Who's that? I can hear you, you know.\""
      ],
      "door": [
        "\"I'm calling the police. I'm doing it right now.\""
      ],
      "inside": [
        "\"Take the telly if you want it. Leave the scorecards.\""
      ],
      "reported": [
        "\"Yes, the Meridian, the top. Thank you, I'll wait.\""
      ],
      "gone": [
        "stands in the middle of the room in his dressing gown, checking the sideboard."
      ]
