      "text": "\"Everyone comes back hungry.\""
    },
    "root": {
      "options": [
        {
          "label": "What's fresh?",
          "next": "__shop__"
        },
        {
          "label": "Lost my appetite.",
          "next": "bye"
        }
      ],
      "text": "The Butcher sets down his cleaver with unsettling gentleness. \"Meat. Fresh, mostly. Cheap, always. You bring me something with meat on it, I'll pay, and I won't ask what it was.\""
    }
