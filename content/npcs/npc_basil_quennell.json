  "chitchat": [
    "\"Tick's for people I know. You'll get there.\"",
    "squares a stack of tins so the labels all face out, then does the next stack",
    "\"If it's not on the shelf I can get it by Thursday. If it's Thursday, Monday.\"",
    "licks a thumb and counts a float that he has already counted twice",
    "\"That one's out of date. It's fine. It's out of date and it's fine, those are two different facts.\""
  ],
  "description": "A narrow man of about sixty in a cardigan with the cuffs gone, working a shop he has clearly been working since he was too young to reach the top shelf without the steps that are still there. He knows the stock by touch. He can tell you what everyone on Filament Street eats and has the tact never to.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"Right you are.\""
    },
    "root": {
      "options": [
        {
          "label": "Let's see what you've got.",
          "next": "__shop__"
        },
        {
          "label": "Another time.",
          "next": "bye"
        }
      ],
      "text": [
        "He is already half turned toward the shelves. \"Go on.\"",
        "\"Morning.\" It is not necessarily morning. \"What are you after?\""
      ],
      "text_by_relation": {
        "familiar": [
          "\"There he is.\" He is already getting the steps out. \"Same, or are we being adventurous?\"",
          "\"Put it on the slate.\" A pause. \"Go on, then, put half of it on the slate.\""
        ],
        "first": "\"Basil. Quennell, but nobody uses it.\" He puts both hands flat on the counter. \"You're in the buildings, then. Right. I do bread, batteries and most of the middle ground.\"",
        "known": "\"You.\" He reaches up without looking and takes down the thing you usually buy. \"This, is it?\""
      }
    }
  },
