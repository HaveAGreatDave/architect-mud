  "banter": [],
  "behaviour_graph": {
    "_start": "",
    "nodes": {}
  },
  "chitchat": [
    "\"Best prices in the district. That's not saying much.\"",
    "\"You touch it, you bought it.\"",
    "\"Everything's genuine. Genuinely acquired.\"",
    "\"Trade you for it. Credits preferred. Bullets accepted.\"",
    "\"Limited supply. Always limited. That's the pitch.\"",
    "\"I don't know where it came from. That's not your business either.\"",
    "\"Come back tomorrow — stock changes. If I'm still here.\"",
    "\"Quality merchandise at prices that won't kill you. Probably.\""
  ],
  "description": "Runs the bar out of a gutted delivery van. Pours with the bored precision of someone who has heard every sob story twice.",
  "dialogue_tree": {
    "bm_air_already": {
      "_vine": {
        "x": 1040,
        "y": 800
      },
      "actions": [],
      "options": [
        {
          "label": "Right.",
          "next": "bm_menu"
        }
      ],
      "text": "\"Already sorted,\" Sully says, not looking up. \"Go fly.\""
    },
    "bm_air_confirmed": {
      "_vine": {
        "x": 1040,
        "y": 700
      },
      "actions": [],
      "options": [
        {
          "label": "Good to know.",
          "next": "bm_menu"
        }
      ],
      "text": "Done. Next time you're out at Buzzard Field in the Reach, ask Amos — he keeps a pallet waiting for you. Fly it home yourself; nobody's walking that through a checkpoint."
    },
    "bm_air_offer": {
      "_vine": {
        "x": 700,
        "y": 700
      },
      "actions": [],
      "options": [
        {
          "actions": [
            {
              "action": "UNLOCK_AIR_CARGO"
            }
          ],
          "label": "I'm in.",
          "next": "bm_air_confirmed"
        },
        {
          "label": "Not yet.",
          "next": "bm_menu"
        }
      ],
      "text": "You lean in. \"Word is you know someone who flies heavier than a MULE drone — no checkpoint at all.\" Sully studies you a long moment. \"...Maybe. Guy works out of the Reach, way out past the wire — grows the raw himself and flies it to whoever's got the nerve. Ask for Amos when you're wheels-down at Buzzard Field. You've run clean enough he'll take the meeting.\""
    },
    "bm_broke": {
      "_vine": {
        "x": 1360,
        "y": 240
      },
      "actions": [],
      "options": [
        {
          "label": "Fair. Let me look again.",
          "next": "bm_menu"
        },
        {
          "label": "Never mind.",
          "next": "root"
        }
      ],
      "text": "Sully snorts and goes back to the glass. \"Come back when your credits clear. I run a cash business, and you're not the kind of face I extend credit to.\""
    },
