              "scope": "player"
            }
          ],
          "next": "architect",
          "text": "\"Whatever the Architect needs me to be.\""
        },
        {
          "actions": [
            {
              "action": "ADJUST_REPUTATION",
              "delta": 8,
              "faction_id": "faction_breakers",
              "reason": "creed:ruin"
            },
