  "chitchat": [
    "\"Bar's open. It doesn't close, it just changes hands.\"",
    "\"You're up late. So's everyone who ends up here.\"",
    "\"Lowry does the daylight. I do the rest.\"",
    "\"Whatever you're about to tell me, I've already heard it at four in the morning.\"",
    "\"Drink it or don't. The stool's the same price.\"",
    "\"Nothing good gets ordered after two. Doesn't stop anyone.\"",
    "\"If you're waiting for someone, wait quietly.\"",
    "\"I don't do last call. There isn't one.\"",
    "\"Tab's open. So's the door. Mind which one you use.\"",
    "\"Sleep's for people with somewhere to be.\""
  ],
  "description": "Night shift at the Embassy Lounge, in a cardigan over the house apron and reading glasses pushed up into grey hair. She keeps a paperback face-down by the taps and picks it up the second you stop talking.",
  "dialogue_tree": {
    "advice": {
      "actions": [
        {
          "action": "BARTENDER_ADVICE"
        }
      ],
      "options": [
        {
          "label": "Anything else?",
          "next": "advice"
        },
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Imogen puts the paperback down and looks at you properly."
    },
    "gossip": {
      "actions": [
        {
          "action": "GOSSIP_TELL"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "She checks the stairwell before she says anything."
    },
    "menu": {
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Same list as the day shift, minus the theatre. The Reserve if you're paying for the idea of it, the Swill if you're not. Canapes are whatever Lowry didn't get through, and they were his idea of complimentary, not mine."
    },
    "poker": {
      "actions": [
        {
          "action": "BARTENDER_POKER"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "She tips her head at the card table without looking at it."
    },
    "root": {
      "options": [
        {
          "label": "What's on the menu?",
          "next": "menu"
        },
        {
          "label": "Any advice for someone new?",
          "next": "advice"
        },
        {
          "label": "What's on the tube?",
          "next": "tv"
        },
        {
          "label": "Who's up at the table?",
          "next": "poker"
        },
        {
          "label": "Heard anything?",
          "next": "gossip"
        },
        {
          "label": "Never mind.",
          "next": null
        }
      ],
      "text": "\"Evening. Or morning. Take your pick, the tap doesn't care.\"",
      "text_by_relation": {
        "familiar": "\"There you are.\" The paperback goes face-down before you've got to the stool. \"Sit. You can tell me what happened while I pour.\"",
        "first": "\"You're new, or you've never been up this late.\" She marks her page with a beer mat. \"Imogen. I have the bar from eight at night until Lowry turns up hungover and calls me valued colleague. Sit where you like, nobody's reserved anything since the Handoff.\"",
        "known": "\"Back at this hour. That's twice.\" She's already reaching for a glass. \"Same again, or are we branching out?\""
      }
    },
    "tv": {
      "actions": [
        {
          "action": "BARTENDER_TV"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "She glances up at the set, which nobody has changed in hours."
    }
  },
