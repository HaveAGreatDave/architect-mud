  "chitchat": [
    "She turns a page below the counter.",
    "The display over the counter clicks, considers it, and stays on 114.",
    "\"Take a ticket. It helps.\""
  ],
  "description": "A neat woman behind the one open window, with reading glasses on a chain and a paperback held below the counter where she thinks nobody can see it.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "The paperback comes back up."
    },
    "job": {
      "options": [
        {
          "label": "Thanks.",
          "next": "bye"
        }
      ],
      "text": "\"Everyone does. A permanent post needs a referee, a fixed address and a surname, and you will forgive me if I guess.\" She slides a leaflet across. \"Casual contracts are on the board in the Grand Lobby, paid the same day at Underwriting. That is how most of them start.\""
    },
    "root": {
      "options": [
        {
          "label": "I want to work for Halcyon.",
          "next": "job"
        },
        {
          "label": "What's the ticket machine for?",
          "next": "ticket"
        },
        {
          "label": "Never mind.",
          "next": "bye"
        }
      ],
      "text": "\"Number?\" She looks over her glasses."
    },
    "ticket": {
      "options": [
        {
          "label": "Back.",
          "next": "root"
        }
      ],
      "text": "\"Morale.\""
    }
  },
