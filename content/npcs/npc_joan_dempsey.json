  "chitchat": [],
  "description": "A tall woman in a navy blazer with a KSAB5 pin on the lapel and a stack of run sheets under one hand. She has a pencil behind her ear and reading glasses on a cord. Her earpiece wire runs down the back of her collar. She checks the clock over the cameras every few seconds.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"Mind the cables on your way out.\""
    },
    "off": {
      "options": [
        {
          "label": "Fair enough.",
          "next": "root"
        }
      ],
      "text": "\"Eight games a day. Lou and I took the flat at Kestrel Court so we could walk in. Ask me again on Cup day.\""
    },
    "pick": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"I don't pick. I read what's on the card. Lou picks, and he's wrong half the time.\""
    },
    "root": {
      "options": [
        {
          "label": "Who do you like tonight?",
          "next": "pick"
        },
        {
          "label": "Do you ever get a day off?",
          "next": "off"
        }
      ],
      "text": "\"Make it quick, we're back in four minutes.\"",
      "text_by_relation": {
        "first": "\"Joan Dempsey, I do the desk here. If you're looking for the production office, it's up the stairs.\"",
        "known": "\"You again. Want the score, or are you just here for the air conditioning?\""
      }
    }
  },
