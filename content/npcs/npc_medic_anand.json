  "chitchat": [
    "\"Stop the bleeding first. Feelings second.\"",
    "\"I don't ask how. I just patch.\"",
    "\"Buy the trauma kit now, thank me at 3 a.m.\""
  ],
  "description": "A calm, tired physician with a stethoscope worn like a scarf and the unhurried competence of someone who has seen worse walk in and worse walk out.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "They turn back to the counter."
    },
    "root": {
      "options": [
        {
          "label": "Patch me up.",
          "next": "treat"
        },
        {
          "label": "Let me see the stock.",
          "next": "shop"
        }
      ],
      "text": "\"Sit if you're dying, browse if you're not. Cabinet's stocked.\""
