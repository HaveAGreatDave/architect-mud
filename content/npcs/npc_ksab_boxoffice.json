  "chitchat": [
    "\"Pass in hand before the light goes, or you're watching it at home like everyone else.\"",
    "Dovie slides the window open a hand's width, decides against it, and slides it shut again."
  ],
  "description": "A heavy-set woman filling a box-office window cut into the soundstage wall, lit from below by the till so she looks permanently unimpressed. A hand-lettered card is taped to her glass: HOUSE OPENS ON THE LIGHT. She has been selling seats to this show since before the second letter of the sign went bad, and she counts change without looking.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"Next.\" The window is already sliding shut."
    },
    "house": {
      "options": [
        {
          "label": "One pass, then.",
          "next": "__shop__"
        },
        {
          "label": "Back.",
          "next": "root"
        }
      ],
      "text": "\"Doors are here, not north. North's the writers now, and they'll thank you not to knock.\" She taps the glass with a knuckle. \"Pass gets you inside and standing where the floor manager puts you. Clap when the sign says clap. Nobody films the monitors.\""
    },
    "root": {
      "options": [
        {
          "label": "What's taping?",
          "next": "show"
        },
        {
          "label": "Sell me a pass.",
          "next": "__shop__"
        },
        {
          "label": "Where does the audience go?",
          "next": "house"
        },
        {
          "label": "Just looking.",
          "next": "bye"
        }
      ],
      "text": "\"Here for the taping?\" Dovie doesn't move anything but her eyes. \"Twenty-five gets you a pass and a place to stand. It doesn't get you a seat, a drink, or an opinion about the show.\""
    },
    "show": {
      "options": [
        {
          "label": "Sell me a pass, then.",
          "next": "__shop__"
        },
        {
          "label": "Back.",
          "next": "root"
        }
      ],
      "text": "\"Same as always: the couch, a guest sweating under the lamp, and a laugh track we've all agreed to become.\" Something that isn't quite a smile. \"It's the closest thing to civic duty we've got left, and it's twenty-five.\""
    }
  },
