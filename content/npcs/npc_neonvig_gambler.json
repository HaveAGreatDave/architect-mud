  "chitchat": [
    "\"One more hand. I can feel it turning.\"",
    "counts a short stack of chips, frowns, counts it again",
    "\"The slots are rigged. The tables are honest. That's why I'm broke.\"",
    "blows on a pair of dice he isn't even using and pockets them",
    "\"You a caller? Sit down. I like callers.\"",
    "watches the poker felt the way a stray watches a butcher's door"
  ],
  "description": "A wiry man in a sweat-ringed shirt and a lucky jacket that has clearly run out of luck. His eyes track every chip in the room and every hand at the felt. He's been here since it opened, or possibly since it was built; nobody's sure he ever leaves. They call him Tally, because he remembers exactly what everyone owes.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"I'll be here. I'm always here.\""
    },
    "game": {
      "options": [
        {
          "label": "You're on.",
          "next": "bye"
        }
      ],
      "text": "\"Always. Grab a seat at the felt and wave me over. I'll pull up a chair and take your credits personally.\""
    },
    "root": {
      "options": [
        {
          "label": "Fancy a game?",
          "next": "game"
        },
        {
          "label": "Any tips?",
          "next": "tips"
        },
        {
          "label": "Later.",
          "next": "bye"
        }
      ],
      "text": "\"Buy in, sit down, lose slow. That's the whole philosophy.\" He grins, and it doesn't reach his eyes."
    },
    "tips": {
      "options": [
        {
          "label": "Noted.",
          "next": "bye"
        }
      ],
      "text": "\"Sure. Never bet the rent. Never chase the slots. And never, ever trust a man who tells you when to fold.\" He pauses. \"Present company excepted.\""
    }
  },
