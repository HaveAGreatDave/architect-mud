  "chitchat": [
    "annotates a loss table with something close to affection.",
    "\"Kamikaze pilots are wonderful for us. They pay premiums and never collect twice.\""
  ],
  "description": "A senior underwriter with the warm handshake of a man pricing your funeral. He can quote the loss rate on any airframe from memory and enjoys, quietly, the moment a pilot realises what \"agreed value\" actually means.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"The desk is always open. Losses rarely keep office hours.\""
    },
    "root": {
      "options": [
        {
          "label": "What does it pay?",
          "next": "terms"
        },
        {
          "label": "Maybe later.",
          "next": "bye"
        }
      ],
      "text": "\"You fly, therefore you fall — statistically. We simply price the interval. Say <b>insure</b> and I'll pull your fleet and quote you.\" He steeples his fingers. \"We keep the wreck, of course.\""
    },
    "terms": {
      "options": [
        {
          "label": "Understood.",
          "next": "bye"
        }
      ],
      "text": "\"A covered total loss pays a fraction of agreed value, less the excess — enough to get you flying again, never enough to make you careless. That distinction is the whole business.\""
    }
  },
