  "chitchat": [
    "\"It's fine. It's just settling.\"",
    "pulls a nail out of an old board with her claw hammer and drops it in a tin."
  ],
  "description": "A short, strong woman in a roofer's knee pads with a claw hammer through her belt. She built the bottom two floors of the Stack and is building the third, and she sleeps in the middle one because it is the warmest.",
  "dialogue_tree": {
    "ask": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"The old houses on the lane. Floorboards, doors, roof laths. Nobody's lived in them since the wall came down, so I don't think anybody minds.\""
    },
    "bye": {
      "options": [],
      "text": "Rowena goes back to her hammering."
