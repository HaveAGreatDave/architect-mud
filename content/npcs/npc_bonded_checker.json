  "chitchat": [
    "clicks the counter without looking at it.",
    "\"Aisle four is short by one. It always is. That is why I am still here.\"",
    "\"Don't stand under the racking. That is not advice.\""
  ],
  "description": "A seal-checker who walks the aisles with a torch and a clicker counter, thumbing every customs tag she passes without breaking step. She has counted this floor nine thousand times and has been wrong twice, and she remembers both.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"Go on. Out the way you came, so I only have to count it once.\""
    },
    "root": {
      "options": [
        {
          "label": "Not stealing anything.",
          "next": "bye"
        }
      ],
      "text": "Quaid stops, puts the torch on you, and keeps it there a beat too long. \"You in the manifest? No. Then you're shrinkage, and shrinkage I write down.\""
    }
