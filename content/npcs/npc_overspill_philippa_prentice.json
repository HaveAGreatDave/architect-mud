  "chitchat": [
    "\"It was the 14. Halcyon to the South Gate and back. Forty minutes, or an hour in snow.\"",
    "wipes the bus windscreen with her sleeve, out of habit."
  ],
  "description": "A broad woman in her sixties in a transit company fleece with the badge still on. She drove buses for the city until the routes were cut, and found this one in the waste the week the wall moved.",
  "dialogue_tree": {
    "ask": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"It was sat out in the waste a hundred yards off with no wheels. When the wall moved, we rolled it on pipes. Took twelve of us a day.\""
    },
    "bye": {
      "options": [],
      "text": "Philippa goes back to her tea."
    },
    "root": {
      "options": [
        {
          "label": "How did you get it here?",
          "next": "ask"
        },
        {
          "label": "Bye.",
          "next": "bye"
        }
      ],
      "text": "\"Morning,\" says Philippa, from the step.",
      "text_by_relation": {
        "familiar": "\"Come and sit on the step if you want. Mind the stove.\"",
        "first": "The woman on the bus step looks you over and nods.\n\n\"Philippa. This is my bus. Well. It's nobody's bus, so it's mine.\"",
        "known": "\"Come and sit on the step if you want. Mind the stove.\""
      }
    }
  },
