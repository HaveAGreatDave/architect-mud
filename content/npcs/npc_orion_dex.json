      "react": {
        "agree": [
          "*nods.*"
        ],
        "apologise": [
          "Forgotten. The cards don't hold grudges. Neither do I, much."
        ],
        "ask_about:badge": [
          "Made it myself. The house never made me one."
        ],
        "ask_about:cheating": [
          "*stops shuffling.* Not at my table. Say it again and you're not either."
        ],
        "ask_about:deck": [
          "New deck every night. I check every one.",
          "*fans it without looking.* Fifty-two. Always."
        ],
        "ask_about:game": [
          "Whoever sits. Seat's open. Say \"I'd like to play\" and I'll deal you in.",
          "Regulars at nine, tourists after. The tourists pay for the regulars."
        ],
        "ask_about:hands": [
          "They don't stop. Cards help."
        ],
        "ask_about:imogen": [
          "Imogen reads the same book all night and never misses a raise from across the room."
        ],
        "ask_about:lowry": [
          "Lowry keeps the room straight. I keep the table straight. We get along."
        ],
        "ask_about:past": [
          "Other tables. Worse ones."
        ],
        "ask_about:rules": [
          "Two in the hand, five on the felt, best five wins. Ask \"Tell me the rules\" for the long version."
        ],
        "ask_about:thumb": {
          "stranger": [
            "*hands keep moving.* Old injury."
          ]
        },
        "ask_advice": [
          "Fold more. Everybody should fold more.",
          "Watch the hands, not the faces."
        ],
        "ask_feeling": [
          "Even. Always even."
        ],
        "ask_job": [
          "Dealer. I keep it fair so you can lose properly."
        ],
        "ask_name": [
          "Orion. It's on the badge."
        ],
        "ask_news": {
          "known": [
            "Somebody's been playing with three aces this week. Not at my table."
          ],
          "stranger": [
            "I don't carry news. I carry a deck."
          ]
        },
        "ask_origin": [
          "From wherever the last game was."
        ],
        "complain": [
