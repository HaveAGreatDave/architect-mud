  "chitchat": [
    "\"I didn't come in. It came out.\"",
    "knocks out her pipe on her stick."
  ],
  "description": "An old woman with a stick, a pipe and a mongrel dog that goes everywhere at her heel. She lived outside the wall, in the waste, for the whole of the time it stood here, and the wall moved to her rather than the other way round.",
  "dialogue_tree": {
    "ask": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"Quiet. Cold. Things came at night and I had a shotgun. Now there's two hundred people within shouting distance and I can't sleep for the noise.\""
    },
    "bye": {
      "options": [],
      "text": "Petronella puts her pipe back in."
    },
    "root": {
      "options": [
        {
          "label": "What was it like outside the wall?",
          "next": "ask"
        },
        {
          "label": "Bye.",
          "next": "bye"
        }
      ],
      "text": "\"Hm,\" says Petronella Swales.",
      "text_by_relation": {
        "familiar": "\"Bob likes you. That's new.\"",
        "first": "The old woman takes her pipe out of her mouth.\n\n\"Swales. I was out there before you lot were in here. The dog's called Bob. Don't touch him.\"",
        "known": "\"Bob likes you. That's new.\""
      }
    }
  },
