  "chitchat": [
    "\"Weigh in or move on.\"",
    "\"Everything's got a price by the gram.\"",
    "\"The works'll kill you slow. I pay fast.\"",
    "\"Don't bring me anything that ticks.\"",
    "\"Scrap's scrap. Bring me more of it.\"",
    "\"Mind the wire on your way in.\""
  ],
  "description": "A wiry old clone with a jeweller's loupe screwed into one eye and a brass hanging-scale bolted to the gatehouse beside him. A strongbox sits chained to his ankle. He weighs everything you carry before he weighs you.",
  "dialogue_tree": {
    "buys": {
      "options": [
        {
          "label": "Show me the shop.",
          "next": "__shop__"
        },
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "\"Metal, wire, components, bone, anything the works spat out that'll fetch a price back in the city. I weigh it, I pay it, and you don't have to haul it through the wastes. I also sell what'll keep you breathing out here, if you're buying.\""
    },
    "bye": {
      "options": [],
      "text": "\"Wastes'll still be here when you change your mind.\""
    },
    "courier_hot": {
      "actions": [
        {
          "action": "OFFER_COURIER_HOT"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Osric finally looks up from the scale, the loupe magnifying one cold eye. \"Delicate. Sure. I've got a thing needs moving quiet, and the usual mules are all in a cell or a ditch.\""
    },
    "gossip": {
      "actions": [
        {
          "action": "GOSSIP_TELL"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Osric taps the scale and leans in."
    },
    "root": {
      "options": [
        {
          "label": "I've got salvage to sell.",
          "next": "__shop__"
        },
        {
          "label": "What do you buy?",
          "next": "buys"
        },
        {
          "label": "Heard anything out here?",
          "next": "gossip"
        },
        {
          "conditions": [
            {
              "flag": "work_fence_blacklist",
              "op": "unset",
              "scope": "player"
            }
          ],
          "label": "[quietly] I can carry something that shouldn't be seen.",
          "next": "courier_hot"
        },
        {
          "label": "Just passing through.",
          "next": "bye"
        }
      ],
      "text": "Osric doesn't look up from the scale. \"You came all this way, so you've either got salvage or you've got a death wish. Which is it?\""
    }
  },
