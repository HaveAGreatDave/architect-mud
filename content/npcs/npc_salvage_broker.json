  "chitchat": [
    "\"Bread's yesterday's. The price is today's.\"",
    "\"Water's boiled. I watched it.\"",
    "\"Batteries are tested. Most of them.\"",
    "\"You pay, then I reach for it.\"",
    "\"Tins don't go off. People say they do. They don't.\"",
    "\"Mind the wire on your way in.\""
  ],
  "description": "A wiry old clone in a grease-stained apron, a pencil behind one ear and a jeweller's loupe pushed up on his forehead. A strongbox under the counter is chained to his ankle. He's counting change into a tin, and he counts it twice.",
  "dialogue_tree": {
    "buys": {
      "options": [
        {
          "label": "Show me the shop.",
          "next": "__shop__"
        },
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "\"Food that keeps, water that's been boiled, soap, and batteries for whatever you've got that still lights up. I'll buy stock off you too, if it's something I can sell on.\""
    },
    "bye": {
      "options": [],
      "text": "\"I don't shut. Mind the step.\""
    },
    "courier_hot": {
      "actions": [
        {
          "action": "OFFER_COURIER_HOT"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Osric pushes the loupe down over one eye and looks at you through it. \"Delicate. Sure. I've got a box needs moving quiet, and the usual mules are all in a cell or a ditch.\""
    },
    "gossip": {
      "actions": [
        {
          "action": "GOSSIP_TELL"
        }
      ],
      "options": [
        {
          "label": "Back",
          "next": "root"
        }
      ],
      "text": "Osric taps the counter and leans in."
    },
    "root": {
      "options": [
        {
          "label": "Show me what you have.",
          "next": "__shop__"
        },
        {
          "label": "What do you stock?",
          "next": "buys"
        },
        {
          "label": "Heard anything out here?",
          "next": "gossip"
        },
        {
          "conditions": [
            {
              "flag": "work_fence_blacklist",
              "op": "unset",
              "scope": "player"
            }
          ],
          "label": "[quietly] I can carry something that shouldn't be seen.",
          "next": "courier_hot"
        },
        {
          "label": "Just passing through.",
          "next": "bye"
        }
      ],
      "text": "Osric looks up from the till. \"Tins, bread, water, soap. If a tent needs it, it's on a shelf in here somewhere.\""
    }
  },
