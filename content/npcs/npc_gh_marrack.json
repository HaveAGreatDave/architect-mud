  "chitchat": [
    "She reads a pass, turns it over, reads the back, and hands it to nobody in particular.",
    "\"Visitors keep to the boulevard. It is a short walk and a long day if you do not.\"",
    "She glances at the feed from the quay and makes a note without looking down."
  ],
  "description": "A compact woman in Halcyon grey with a sergeant's bar on the collar and a pass reader clipped to her belt. She looks at your hands first and your face second.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "She goes back to the screens."
    },
    "guard": {
      "options": [
        {
          "label": "Back.",
          "next": "root"
        }
      ],
      "text": "\"Halcyon property. Buildings, people, papers.\" She taps a screen. \"Mostly papers. People steal buildings less often than you would think.\""
    },
    "root": {
      "options": [
        {
          "label": "I don't have one.",
          "next": "visitor"
        },
        {
          "label": "What does Halcyon Security guard?",
          "next": "guard"
        },
        {
          "label": "Never mind.",
          "next": "bye"
        }
      ],
      "text": "\"Pass?\" She holds out a hand without looking up from the screens."
    },
    "visitor": {
      "options": [
        {
          "label": "Understood.",
          "next": "bye"
        }
      ],
      "text": "\"Then you are a visitor. Visitors keep to the boulevard and the arcade, and they do not stand still for long.\" She looks at you properly for the first time. \"That is not a threat. It is the policy. The threat is separate.\""
    }
  },
