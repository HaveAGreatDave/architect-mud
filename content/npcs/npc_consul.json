  "chitchat": [
    "greets someone she is currently undermining with genuine warmth.",
    "\"Diplomacy is simply war with better catering.\""
  ],
  "description": "A career corporate diplomat who has negotiated three ceasefires and broken all of them personally. She is unfailingly gracious, which is how you know to be afraid.",
  "dialogue_tree": {
    "accepted": {
      "actions": [
        {
          "action": "START_QUEST",
          "quest_id": "quest_downwind"
        }
      ],
      "options": [
        {
          "label": "Understood.",
          "next": "bye"
        }
      ],
      "text": "\"Marvellous. Oxide Flats and the Downwind, just past the Manifold's edge. Do be discreet; the whole point of downwind is that no one sees it.\""
    },
    "bye": {
      "options": [],
      "text": "\"Do give my regards to no one in particular.\""
    },
    "quest_offer": {
      "options": [
        {
          "label": "Consider it cleared.",
          "next": "accepted"
        },
        {
          "label": "It's handled. (report back)",
          "next": "reported"
        },
        {
          "label": "Find someone else.",
          "next": "bye"
        }
      ],
      "text": "\"We dump our unpleasantness downwind, as one does, and something has moved into it — slag wights, fouling the very ground where a rather important accord is to be signed outdoors, for the optics. Clear two of them before the signing and the Concordat will remember you fondly, in bond form.\""
    },
    "reported": {
      "actions": [
        {
          "action": "TURN_IN",
          "quest_id": "quest_downwind"
        }
      ],
      "options": [
        {
          "label": "Obliged.",
          "next": "bye"
        }
      ],
      "text": "\"...The signing ground is clean, the delegates none the wiser, and everyone will take credit but you. Which is precisely why I'm paying you in a bond that names no one. We understand each other.\""
    },
    "root": {
      "options": [
        {
          "label": "Go on.",
          "next": "quest_offer"
        },
        {
          "label": "Not today.",
          "next": "bye"
        }
      ],
      "text": "Consul Reyes turns to you with a smile of flawless, weaponised courtesy. \"You have the look of someone who resolves things off the record. As it happens, I have a thing that requires resolving. Off the record.\""
    }
  },
