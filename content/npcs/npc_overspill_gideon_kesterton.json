  "chitchat": [
    "\"Two days. Pallets, wire, a tarp and a car door. You want one, it's a week's wait.\"",
    "rubs his knee and swears at it."
  ],
  "description": "A bald man with a carpenter's pencil and a bad knee, who built the Pallet House in two days and will tell you so. He builds for other people now, for food or tobacco, and he is booked up.",
  "dialogue_tree": {
    "ask": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"I can. A week, for food. You bring the pallets or I charge for them. The car door was a one-off.\""
    },
    "bye": {
      "options": [],
      "text": "Gideon goes back to the pallet he's wiring."
    },
    "root": {
      "options": [
        {
          "label": "Can you build me one?",
          "next": "ask"
        },
        {
          "label": "Bye.",
          "next": "bye"
        }
      ],
      "text": "\"You again,\" says Gideon.",
      "text_by_relation": {
        "familiar": "\"Pass me that wire, would you.\"",
        "first": "The bald man doesn't stop working.\n\n\"Gideon. I built that. Two days. If you're asking, it's a week's wait.\"",
        "known": "\"Pass me that wire, would you.\""
      }
    }
