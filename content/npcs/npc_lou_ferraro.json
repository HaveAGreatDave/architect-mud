  "chitchat": [],
  "description": "A heavy man in a brown check jacket that doesn't quite button, with a broken nose and big scarred hands flat on the desk. A paper cup of coffee sits by his elbow next to a scorecard covered in pencil. He has a two-day shadow the makeup hasn't quite hidden.",
  "dialogue_tree": {
    "bye": {
      "options": [],
      "text": "\"See you.\""
    },
    "nose": {
      "options": [
        {
          "label": "Right.",
          "next": "root"
        }
      ],
      "text": "\"A puck, then a guy, then the same guy. I stopped getting it fixed.\""
    },
    "pick": {
      "options": [
        {
          "label": "Thanks.",
          "next": "root"
        }
      ],
      "text": "\"Whoever gets the first one. Don't put money on that.\""
    },
    "root": {
      "options": [
        {
          "label": "Who wins tonight?",
          "next": "pick"
        },
        {
          "label": "What happened to your nose?",
          "next": "nose"
        }
      ],
      "text": "\"Yeah?\"",
      "text_by_relation": {
        "first": "\"Lou Ferraro. I played nine years and now I tell people what they just watched.\"",
        "known": "\"Back again. Sit down if you want, just not in Joan's chair.\""
      }
    }
  },
