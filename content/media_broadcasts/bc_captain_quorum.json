        "type": "overlay"
      },
      "bsm_52": {
        "_vine": {
          "x": 520,
          "y": 1680
        },
        "next": "bsm_53",
        "style": "narration",
        "text": "An empty hall with the chairs stacked. On the far wall, low, half hidden behind them: a small painted-over cabinet with a little glass window.",
        "type": "say"
      },
      "bsm_53": {
        "_vine": {
          "x": 740,
          "y": 1680
        },
        "next": "bsm_54",
        "style": "narration",
        "text": "The meter clause was struck.",
        "type": "say"
      },
      "bsm_54": {
        "_vine": {
          "x": 960,
          "y": 1680
        },
        "next": "bsm_55",
        "style": "narration",
        "text": "The meters stayed.",
        "type": "say"
      },
