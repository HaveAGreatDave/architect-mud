      },
      "bsm_51": {
        "type": "overlay",
        "overlayType": "lower_third",
        "text": "THE CIVIC HALL",
        "subtext": "THE FOLLOWING SPRING",
        "graphic_id": "",
        "duration_s": 6,
        "_vine": {
          "x": 300,
          "y": 1680
        },
        "next": "bsm_52"
      },
      "bsm_52": {
        "type": "say",
        "text": "An empty hall with the chairs stacked. On the far wall, low, half hidden behind them: a small painted-over cabinet with a little glass window.",
        "style": "narration",
        "_vine": {
          "x": 520,
          "y": 1680
        },
        "next": "bsm_53"
      },
      "bsm_53": {
        "type": "say",
        "text": "The meter clause was struck.",
        "style": "narration",
        "_vine": {
          "x": 740,
          "y": 1680
        },
        "next": "bsm_54"
      },
      "bsm_54": {
        "type": "say",
        "text": "The meters stayed.",
        "style": "narration",
        "_vine": {
          "x": 960,
          "y": 1680
        },
        "next": "bsm_55"
      },
