      "bsm_57": {
        "_vine": {
          "x": 520,
          "y": 1840
        },
        "duration": 18,
        "text": "CAPTAIN QUORUM in \"A FRIENDLY AMENDMENT\"\n\nCaptain Quorum .......... a man who read the Standing Orders\nThe Amender ............. third row, aisle seat\nThe Clerk ............... keeper of the minutes\n\nPRODUCED BY THE CIVIC MORALE DIRECTORATE\nPrinted by authority. Not to be retained after the period of currency.",
        "type": "credits"
      },
      "bsm_6": {
        "_vine": {
          "x": 300,
          "y": 240
        },
        "next": "bsm_7",
        "style": "narration",
        "text": "Bunting. A dais. Two hundred citizens in the seats, and the extras have all been directed to face front and not to move their heads.",
        "type": "say"
      },
      "bsm_7": {
        "_vine": {
          "x": 520,
          "y": 240
        },
        "next": "bsm_8",
        "style": "narration",
        "text": "The Directorate produced eleven of these. Nine are lost. This isn't one of the good ones.",
        "type": "say"
      },
      "bsm_8": {
        "_vine": {
          "x": 740,
          "y": 240
        },
        "duration_s": 8,
        "next": "bsm_9",
        "overlayType": "act_card",
        "subtext": "The Chair Recognises",
        "text": "ACT 1",
        "type": "overlay"
      },
      "bsm_9": {
        "_vine": {
          "x": 960,
          "y": 240
        },
        "next": "bsm_10",
        "style": "narration",
        "text": "CAPTAIN QUORUM enters to applause that starts a half-second before he appears.",
        "type": "say"
      },
