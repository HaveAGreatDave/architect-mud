      "bsm_45": {
        "_vine": {
          "x": 80,
          "y": 1520
        },
        "duration": 18,
        "text": "NIGHT SHIFT AT NUMBER FOUR\n\nAda Delph .............. the new hand\nThe Foreman ............ who signs the forms\nThe Pour ............... itself\n\nA MELTWATER DRIVE-IN RELEASING PICTURE\n\nNo foundry gave permission for any of this.",
        "type": "credits"
      },
      "bsm_5": {
        "_vine": {
          "x": 80,
          "y": 240
        },
        "duration_s": 6,
        "graphic_id": "",
        "next": "bsm_6",
        "overlayType": "lower_third",
        "subtext": "THIRD SHIFT",
        "text": "NUMBER FOUR FOUNDRY",
        "type": "overlay"
      },
      "bsm_6": {
        "_vine": {
          "x": 300,
          "y": 240
        },
        "next": "bsm_7",
        "style": "narration",
        "text": "A woman signs a book at a gate under a lamp with moths in it. This is ADA DELPH and she has never held a ladle in her life.",
        "type": "say"
      },
      "bsm_7": {
        "_vine": {
          "x": 520,
          "y": 240
        },
        "next": "bsm_8",
        "style": "narration",
        "text": "They were forty hands short that winter and they were not fussy about it.",
        "type": "say"
      },
      "bsm_8": {
        "_vine": {
          "x": 740,
          "y": 240
        },
        "duration_s": 8,
        "next": "bsm_9",
        "overlayType": "act_card",
        "subtext": "The New Hand",
        "text": "ACT 1",
        "type": "overlay"
      },
      "bsm_9": {
        "_vine": {
          "x": 960,
          "y": 240
        },
        "next": "bsm_10",
        "style": "narration",
        "text": "The floor. Heat haze rendered by shooting through a fire, which is the sort of thing Prine did instead of paying for an effect.",
        "type": "say"
      },
