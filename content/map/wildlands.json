      "biome": "ash",
      "reach": 55
    },
    "region_the_reach": {
      "biome": "scrub",
      "reach": 42
    },
    "region_scarletwastes": {
      "biome": "scarlet",
      "reach": 48
    },
    "region_terminus": {
      "biome": "hardpan",
      "reach": 40
    },
    "region_coldwater": {
