@actor npc_arrears_gil
@billing npc_arrears_gil Gil Haddow
@actor npc_arrears_dot
@billing npc_arrears_dot Dot Haddow
@actor npc_arrears_nan
@billing npc_arrears_nan Nan
@actor npc_arrears_prosser
@billing npc_arrears_prosser Mr Prosser
::endactors

