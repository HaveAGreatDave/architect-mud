@broadcast "Cluster Puck: CPhL Coldwater Hockey"
@channel 7
@category sport
@type sports
@sport hockey
@announcer "Tug Brennan"
# The booth's own voice, over the station's: no ring modulator and no drive. Both are
# texture, and both cost words: measured, the clean voice is understood about 10% better.
@voice ring=0 drive=0 vs=1
@airtime 18
@length 300
@titlecard cphl_title

# =============================================================================
# CLUSTER PUCK — the CPhL line library, called by Tug Brennan.
#
# There is no game in the world. Every airing the sports runner SIMULATES a fresh
# sixty minutes (plugins/broadcast/sports/hockey.js) — picks two clubs below,
# deals lineups, and plays out scoring chances while tracking the score, the
# penalty boxes, the injuries and the bodies. Then it assembles the play-by-play
# from these pools, one random line per beat, {tokens} filled from live game
# state. Different clubs, different score, every single time.
#
# THE LEAGUE. Nobody founded the CPhL. "Cluster" is what the pre-Handoff
# operators called the machine, and the machine is still running — some
# Architect-adjacent scheduler has emitted matchups on a fixed cycle since before
# anyone alive was born. No commissioner, no league office, no records. The clubs
# receive their pairing and turn up. The lowercase h in CPhL is a letterhead typo
# and there is no surviving authority competent to correct it.
#
# THE HOCKEY. Not the NHL. Hits maim, penalties are casualties, an injured man is
# NOT replaced so his side finishes short, a fight loser serves five and the
# winner's team gets the power play, and overtime is called sudden death because
# it ends on the first goal OR the first fatality, whichever arrives first.
#
# TEXT PARITY IS THE RULE. Every beat the sim emits has a pool here — including
# the boards hits, the scrums, the injuries, the fatalities and the pulled
# goalie. Nothing may exist only as an animation on the Gameday screen; a player
# reading the text must get the whole game. The announcer is a NAME, not an NPC.
# See docs/bsm-format.md#sports-broadcasts-type-sports.
# =============================================================================

::asset cphl_title
<!--
  THE OPEN. Title-card SVGs are parsed into live DOM by tv.js (not dropped into an
  <img>), so a <style> block inside the asset really runs — which is why this is an
  animated broadcast open and not a poster. It plays once, on air, in about 4 seconds:
  the sheet wipes in from the left, the mark lands with a shockwave, the wordmark
  clip-reveals behind a moving light bar, the goal lamp fires twice, and the strapline
  types itself under it. Everything is declarative CSS on a single timeline — no JS
  reaches into this, so it renders identically on every TV in the world.
-->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" font-family="'Segoe UI',Helvetica,Arial,sans-serif">
  <defs>
    <linearGradient id="cpsky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#101c2a"/><stop offset="0.55" stop-color="#0a1018"/><stop offset="1" stop-color="#04070b"/>
    </linearGradient>
    <linearGradient id="cpice" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7d99b8"/><stop offset="0.55" stop-color="#c3d6e8"/><stop offset="1" stop-color="#eef5fb"/>
    </linearGradient>
    <linearGradient id="cpsteel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/><stop offset="0.42" stop-color="#cfe4f4"/>
      <stop offset="0.52" stop-color="#7fa8c8"/><stop offset="1" stop-color="#e8f3fb"/>
    </linearGradient>
    <linearGradient id="cpsweep" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#4fd2ff" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#bdefff" stop-opacity="0.95"/>
      <stop offset="1" stop-color="#4fd2ff" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="cplamp" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ff5a4a" stop-opacity="0.9"/><stop offset="1" stop-color="#ff2b3a" stop-opacity="0"/>
    </radialGradient>
    <!-- The wipes ARE these two rects: the animation runs on the clip rect itself
         (SVG2 geometry properties are CSS-animatable), so the artwork underneath is
         plain static SVG and only the mask moves. -->
    <clipPath id="cpwordclip"><rect class="cp-word-rect" x="46" y="120" width="0" height="92"/></clipPath>
    <clipPath id="cpsheetclip"><rect class="cp-sheet-rect" x="0" y="228" width="0" height="132"/></clipPath>
    <style><![CDATA[
      .cp-sheet-rect { animation: cpWipe 0.62s cubic-bezier(.16,.9,.3,1) 0.1s both; }
      .cp-word-rect  { animation: cpWipe 0.72s cubic-bezier(.16,.9,.3,1) 0.62s both; }
      @keyframes cpWipe { from { width: 0; } to { width: 640px; } }
      .cp-sweep  { animation: cpSweep 1.05s cubic-bezier(.3,.1,.2,1) 0.58s both; }
      @keyframes cpSweep { from { transform: translateX(-260px); opacity: 0; } 12% { opacity: 1; } to { transform: translateX(660px); opacity: 0; } }
      .cp-mark   { transform-origin: 92px 168px; animation: cpMark 0.5s cubic-bezier(.2,1.7,.35,1) 0.34s both; }
      @keyframes cpMark { from { transform: scale(2.6) rotate(-24deg); opacity: 0; } 70% { opacity: 1; } to { transform: scale(1) rotate(0); opacity: 1; } }
      .cp-shock  { transform-origin: 92px 168px; animation: cpShock 0.8s ease-out 0.6s both; }
      @keyframes cpShock { from { transform: scale(0.2); opacity: 0.9; } to { transform: scale(3.4); opacity: 0; } }
      .cp-rule   { transform-origin: left center; animation: cpRule 0.5s cubic-bezier(.16,.9,.3,1) 1.15s both; }
      @keyframes cpRule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      .cp-sub    { animation: cpFade 0.7s ease-out 1.35s both; }
      .cp-foot   { animation: cpFade 0.8s ease-out 1.75s both; }
      @keyframes cpFade { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
      .cp-lamp   { animation: cpLamp 0.34s steps(1) 1.5s 4 both; }
      @keyframes cpLamp { 0%,49% { opacity: 0.95; } 50%,100% { opacity: 0.12; } }
      .cp-scan   { animation: cpScan 3.4s linear 0s infinite; }
      @keyframes cpScan { from { transform: translateY(-14px); } to { transform: translateY(374px); } }
      .cp-puck   { animation: cpPuck 0.85s cubic-bezier(.1,.7,.2,1) 0.5s both; }
      @keyframes cpPuck { from { transform: translateX(360px); } to { transform: translateX(0); } }
    ]]></style>
  </defs>

  <rect width="640" height="360" fill="url(#cpsky)"/>

  <!-- upper bowl: crowd as a dark texture, not as faces. Nobody in this league has a face. -->
  <g opacity="0.55">
    <rect x="0" y="0" width="640" height="86" fill="#070c12"/>
    <g fill="#1d2a38">
      <rect x="0" y="58" width="640" height="4"/><rect x="0" y="70" width="640" height="3"/>
    </g>
    <g fill="#2b3a4c" opacity="0.85">
      <circle cx="34" cy="26" r="4"/><circle cx="88" cy="40" r="4"/><circle cx="142" cy="20" r="4"/>
      <circle cx="204" cy="38" r="4"/><circle cx="266" cy="24" r="4"/><circle cx="330" cy="42" r="4"/>
      <circle cx="392" cy="22" r="4"/><circle cx="454" cy="40" r="4"/><circle cx="516" cy="26" r="4"/>
      <circle cx="582" cy="42" r="4"/>
    </g>
  </g>

  <!-- the sheet, wiped in from the left -->
  <g clip-path="url(#cpsheetclip)">
    <rect x="0" y="228" width="640" height="132" fill="url(#cpice)"/>
    <path d="M0 262 L640 262" stroke="#2f6fd0" stroke-width="4" opacity="0.8"/>
    <path d="M0 316 L640 316" stroke="#c8382f" stroke-width="3" opacity="0.85"/>
    <g stroke="#8fb0cc" stroke-width="1.6" opacity="0.4">
      <path d="M60 348 L128 300"/><path d="M186 352 L246 306"/><path d="M330 300 L402 346"/>
      <path d="M448 296 L512 340"/><path d="M120 286 L176 268"/><path d="M470 272 L528 290"/>
    </g>
    <!-- what else gets left on it -->
    <g fill="#a8121c" opacity="0.75">
      <ellipse cx="286" cy="336" rx="13" ry="4"/><ellipse cx="303" cy="344" rx="7" ry="2.5"/>
      <ellipse cx="270" cy="329" rx="4" ry="1.8"/>
    </g>
    <g class="cp-puck">
      <ellipse cx="524" cy="330" rx="14" ry="6" fill="#04070a"/>
      <ellipse cx="524" cy="326" rx="14" ry="6" fill="#1b2026" stroke="#39424c" stroke-width="1"/>
    </g>
  </g>

  <!-- the mark: a puck struck through by the league's one straight line -->
  <g class="cp-shock"><circle cx="92" cy="168" r="26" fill="none" stroke="#4fd2ff" stroke-width="3"/></g>
  <g class="cp-mark">
    <circle cx="92" cy="168" r="34" fill="#080d14" stroke="#4fd2ff" stroke-width="2.5"/>
    <circle cx="92" cy="168" r="26" fill="none" stroke="#1d4a63" stroke-width="1.2"/>
    <path d="M64 186 L120 150" stroke="#c8382f" stroke-width="7" stroke-linecap="round"/>
    <text x="92" y="177" text-anchor="middle" font-size="27" font-weight="700" fill="#e9f5ff" letter-spacing="1">CP</text>
  </g>

  <!-- wordmark, revealed behind a moving light bar -->
  <g clip-path="url(#cpwordclip)">
    <text x="146" y="176" font-size="62" font-weight="700" fill="url(#cpsteel)" letter-spacing="2">CLUSTER</text>
    <text x="146" y="176" font-size="62" font-weight="700" fill="none" stroke="#0a1018" stroke-width="0.8" letter-spacing="2">CLUSTER</text>
    <text x="404" y="176" font-size="62" font-weight="700" fill="#c8382f" letter-spacing="2">PUCK</text>
  </g>
  <rect class="cp-sweep" x="0" y="118" width="150" height="96" fill="url(#cpsweep)" opacity="0"/>

  <rect class="cp-rule" x="146" y="192" width="404" height="4" fill="#4fd2ff"/>

  <!-- the goal lamp, top right, doing the one thing it has never failed to do -->
  <g class="cp-lamp">
    <circle cx="596" cy="128" r="26" fill="url(#cplamp)"/>
    <circle cx="596" cy="128" r="8" fill="#ff3b4a"/>
  </g>

  <text class="cp-sub" x="146" y="218" font-size="14" fill="#8fbcd8" letter-spacing="8">CPhL &#183; COLDWATER HOCKEY</text>
  <text class="cp-foot" x="24" y="350" font-size="11" fill="#54616e" letter-spacing="3">NO OFFICE &#183; NO OWNERS &#183; NO RECORDS</text>
  <text class="cp-foot" x="616" y="350" text-anchor="end" font-size="11" fill="#8fbcd8" letter-spacing="3">with TUG BRENNAN</text>

  <!-- broadcast scanline, running forever: this is a transmission, not a picture -->
  <rect class="cp-scan" x="0" y="0" width="640" height="14" fill="#7fd4ff" opacity="0.045"/>
  <rect x="0" y="0" width="640" height="360" fill="none" stroke="#4fd2ff" stroke-width="2" opacity="0.28"/>
</svg>
::endasset

