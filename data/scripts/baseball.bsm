@broadcast "Deadball: Coldwater League Baseball"
@channel sport1
@category sport
@type sports
@sport baseball
@sim 2
@announcer "Chip Vega"
@airtime 19
@length 300
@titlecard bb_deadball_title
# The network open: KSAB-7 Sports' theme, built from the organist's one song
# (scripts/content/build-ksab-theme.mjs). It plays once under the title card, which holds for it.
@theme ksab7_deadball_theme

# =============================================================================
# DEADBALL — line library for the ballpark broadcast, called by Chip Vega.
# There is no game in the world; the sports runner SIMULATES a fresh nine innings
# every airing — picks two teams below, deals lineups from the player pool, and
# plays randomized at-bats while tracking the score. It then assembles the
# play-by-play from these pools, one random line per event, {tokens} filled from
# the live game state. Different teams, different score, every single time.
# The announcer is a NAME, not an NPC — no studio host is ever spawned.
# See docs/bsm-format.md#sports-broadcasts-type-sports.
# =============================================================================

# --- Title card: shown once before the game each airing (@titlecard above) -----
# SVG asset; the runner content-sniffs the <svg> tag and renders it as a graphic.
::asset bb_deadball_title
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" class="k7d" role="img" aria-label="KSAB-7 Sports presents Deadball, Coldwater League Baseball, live from the Charles B. Hughson Coliseum, with Chip Vega." font-family="'K7 Audiowide', Audiowide, Bahnschrift, 'Segoe UI', sans-serif">
  <!-- Generated by scripts/content/build-ksab-opens.mjs: edit that, not this. The KSAB-7 Sports open,
       cut to the network's theme (34.55 s at 132 bpm), which plays under it once. -->
  <defs>
    <linearGradient id="k7d-plate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#11474a"/><stop offset="0.55" stop-color="#082426"/><stop offset="1" stop-color="#031012"/>
    </linearGradient>
    <path id="k7d-lamps" d="M-16,-10h6.5v5h-6.5zM-7.5,-10h6.5v5h-6.5zM1,-10h6.5v5h-6.5zM9.5,-10h6.5v5h-6.5zM-16,-3h6.5v5h-6.5zM-7.5,-3h6.5v5h-6.5zM1,-3h6.5v5h-6.5zM9.5,-3h6.5v5h-6.5zM-16,4h6.5v5h-6.5zM-7.5,4h6.5v5h-6.5zM1,4h6.5v5h-6.5zM9.5,4h6.5v5h-6.5z"/><path id="k7d-burst" d="M5.97,0.6L49.75,4.99M5.41,2.6L45.04,21.71M4.19,4.3L34.9,35.8M2.47,5.47L20.55,45.58M0.45,5.98L3.72,49.86M-1.63,5.78L-13.55,48.13M-3.5,4.87L-29.2,40.59M-4.96,3.38L-41.32,28.15M-5.81,1.48L-48.46,12.32M-5.97,-0.6L-49.75,-4.99M-5.41,-2.6L-45.04,-21.71M-4.19,-4.3L-34.9,-35.8M-2.47,-5.47L-20.55,-45.58M-0.45,-5.98L-3.72,-49.86M1.63,-5.78L13.55,-48.13M3.5,-4.87L29.2,-40.59M4.96,-3.38L41.32,-28.15M5.81,-1.48L48.46,-12.32" stroke-width="2.3" stroke-linecap="round" stroke-dasharray="30 5 3 60"/>
    <linearGradient id="k7d-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#03070d"/><stop offset="0.45" stop-color="#081622"/><stop offset="0.7" stop-color="#10222c"/><stop offset="1" stop-color="#0a1a14"/>
    </linearGradient>
    <radialGradient id="k7d-glow" cx="0.5" cy="1" r="0.75">
      <stop offset="0" stop-color="#ff60a8" stop-opacity="0.28"/><stop offset="0.5" stop-color="#ff9a5a" stop-opacity="0.08"/><stop offset="1" stop-color="#ff9a5a" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="k7d-halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fffbe8" stop-opacity="0.95"/><stop offset="0.25" stop-color="#ffe9a8" stop-opacity="0.45"/><stop offset="1" stop-color="#ffe9a8" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="k7d-beam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6d6" stop-opacity="0.42"/><stop offset="0.6" stop-color="#fff6d6" stop-opacity="0.08"/><stop offset="1" stop-color="#fff6d6" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="k7d-search" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#bfe8ff" stop-opacity="0.35"/><stop offset="1" stop-color="#bfe8ff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="k7d-grass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1d5a2c"/><stop offset="1" stop-color="#2f7d3c"/>
    </linearGradient>
    <radialGradient id="k7d-dirt" cx="0.5" cy="0.3" r="0.7">
      <stop offset="0" stop-color="#b5713f"/><stop offset="1" stop-color="#7a4524"/>
    </radialGradient>
    <linearGradient id="k7d-chrome" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/><stop offset="0.45" stop-color="#e9eef2"/><stop offset="0.5" stop-color="#9aa6b2"/><stop offset="0.62" stop-color="#d6dde3"/><stop offset="1" stop-color="#ffffff"/>
    </linearGradient>
    <linearGradient id="k7d-goldfill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff4c2"/><stop offset="0.45" stop-color="#ffd257"/><stop offset="0.52" stop-color="#b8761c"/><stop offset="0.66" stop-color="#ffcb4a"/><stop offset="1" stop-color="#fff0b8"/>
    </linearGradient>
    <linearGradient id="k7d-underfill" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ff7a1a"/><stop offset="1" stop-color="#ffb547"/>
    </linearGradient>
    <linearGradient id="k7d-sweepfill" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0"/><stop offset="0.5" stop-color="#ffffff" stop-opacity="0.9"/><stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="k7d-streakfill" x1="0" y1="0" x2="1" y2="0">
