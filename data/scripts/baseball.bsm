      <text x="44" y="168" font-family="'K7 Bungee', Bungee, 'Arial Black', Impact, sans-serif" font-size="74" textLength="224" lengthAdjust="spacingAndGlyphs">DEAD</text>
      <text x="280" y="168" font-family="'K7 Bungee', Bungee, 'Arial Black', Impact, sans-serif" font-size="74" textLength="224" lengthAdjust="spacingAndGlyphs">BALL</text>
    </clipPath>
