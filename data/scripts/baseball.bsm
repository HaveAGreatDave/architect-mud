      <stop offset="0" stop-color="#fff8dc" stop-opacity="1"/><stop offset="0.3" stop-color="#ffb547" stop-opacity="0.75"/><stop offset="1" stop-color="#ff5a1f" stop-opacity="0"/>
    </linearGradient>
