      .k7d-beam { fill: url(#k7d-beam); animation: k7d-sway 6s ease-in-out infinite alternate; }
      @keyframes k7d-sway { from { transform: rotate(-2.2deg); } to { transform: rotate(2.2deg); } }
      .k7d-faulty { animation: k7d-faulty 3.7s steps(1) infinite; }
