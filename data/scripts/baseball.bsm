    <rect x="0" y="304" width="640" height="30" fill="#061216" opacity="0.9"/>
    <rect x="0" y="304" width="640" height="1.6" fill="#3df0d8"/>
    <rect x="14" y="311" width="52" height="16" rx="3" fill="#d81f2a"/>
    <circle class="k7d-dot" cx="24" cy="319" r="3.2" fill="#ffffff"/>
    <text x="31" y="323.3" font-size="10" fill="#ffffff" textLength="28" lengthAdjust="spacing">LIVE</text>
    <text x="78" y="325" font-family="'K7 Shoulders', 'Big Shoulders Display', 'Arial Narrow', Impact, sans-serif" font-weight="800" font-size="17" fill="#e8f6f4" textLength="268" lengthAdjust="spacingAndGlyphs">CHARLES B. HUGHSON COLISEUM</text>
    <text x="356" y="324" font-size="9" fill="#3df0d8" textLength="70" lengthAdjust="spacing">COLDWATER</text>
    <text x="626" y="325" text-anchor="end" font-family="'K7 Shoulders', 'Big Shoulders Display', 'Arial Narrow', Impact, sans-serif" font-weight="800" font-size="17" fill="#ffffff" textLength="82" lengthAdjust="spacingAndGlyphs">CHIP VEGA</text>
    <text x="538" y="324" text-anchor="end" font-size="9" fill="#3df0d8">with</text>
  </g>

  <!-- light: the streak, the ring, the flash -->
  <g class="k7d-streak"><rect x="-120" y="140" width="420" height="22" fill="url(#k7d-streakfill)" opacity="0.25"/><rect x="-60" y="149.5" width="300" height="3" fill="url(#k7d-streakfill)"/></g>
  <circle class="k7d-ring" cx="320" cy="150" r="40" fill="none" stroke="#ffffff" stroke-width="3"/>
  <rect class="k7d-flash" width="640" height="360" fill="#ffffff"/>
  <rect width="640" height="360" fill="url(#k7d-scan)"/>
  <rect width="640" height="360" fill="url(#k7d-vignette)"/>
</svg>
::endasset

# --- Team pool: the runner picks two (home + away) per airing -----------------
# Eight clubs, as the CPhL has. The Blue Birds' and the Crows' looks (crests, colours,
# kits) are built by scripts/content/build-deadball-clubs.mjs; the other six wear the
# house kits until they're replaced. Change this list and bump `era` in
# plugins/sportsleague/index.js.
::teams
Basin Blue Birds
Coldwater Crows
Rustpile Red Sox
Marquee Mastodons
Yards Yellowjackets
Westside White Sox
Docks District Dolphins
Boomtown Bombers
::endteams

