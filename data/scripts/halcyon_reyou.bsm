@broadcast "Halcyon Re-You™ - When The First Time Wasn't Good Enough"
@category commercial
@length 60
@type commercial

::actors
@actor npc_narrator
@alias npc_narrator NARRATOR
@actor npc_reyou_dessa
@alias npc_reyou_dessa DESSA
@actor npc_reyou_orrin
@alias npc_reyou_orrin ORRIN
@actor npc_reyou_bex
@alias npc_reyou_bex BEX
@actor npc_reyou_tuck
@alias npc_reyou_tuck TUCK
@actor npc_reyou_marguerite
@alias npc_reyou_marguerite MARGUERITE
::endactors

