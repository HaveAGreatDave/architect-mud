@broadcast "Everything Must Go"
@channel ksab_tv
@category shopping
@length 180
@type scripted

::actors
@actor npc_emg_vance
@billing npc_emg_vance Vance Pellow
@actor npc_emg_jolene
@billing npc_emg_jolene Jolene Marsh
@actor npc_emg_pim
@billing npc_emg_pim Pim
::endactors

::asset emg_logo
