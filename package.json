{
  "name": "architect-mud",
  "version": "0.1.0",
  "description": "Post-singularity browser MUD",
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-orphans.js && node scripts/content/check-stale.mjs --import",
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "kill:orphans": "node scripts/kill-orphans.js",
    "pretest:regress": "node scripts/kill-orphans.js && node scripts/content/lint.mjs && node scripts/content/check-stale.mjs --import",
    "test:regress": "node tests/regress.js",
    "sync:commits": "node scripts/sync-commits.js",
    "hooks:install": "node scripts/install-hooks.mjs",
    "db:schema": "node server/models/schema.js",
    "db:report": "node tools/schema-report/report.mjs",
    "db:world-report": "node tools/world-report/report.mjs",
    "db:vine-lint": "node tools/vine-lint/lint.mjs",
    "db:economy-report": "node tools/economy-report/report.mjs",
    "canary": "node tools/canary/canary.mjs",
    "combat-sim": "node tools/combat-sim/sim.mjs",
    "db:restore": "node server/models/restore.js",
    "db:create-local": "node scripts/create-local-db.mjs",
    "db:backup-prod": "node scripts/backup-prod.mjs",
    "content:export": "node scripts/content/export.mjs",
    "precontent:import": "node scripts/content/lint.mjs",
    "content:import": "node scripts/content/import.mjs",
    "content:seed-runtime": "node scripts/content/seed-runtime.mjs",
    "content:lint": "node scripts/content/lint.mjs",
    "content:status": "node scripts/content/status.mjs",
    "content:dangling": "node scripts/content/check-dangling.mjs",
    "db:rename-admin": "node server/models/temp/rename-admin.js",
    "db:reset-chars": "node server/models/temp/reset-chars.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.3",
    "uuid": "^14.0.1",
    "ws": "^8.16.0"
  }
}
