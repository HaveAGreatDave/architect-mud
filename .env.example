# Copy this to .env for local development.
# Use the SESSION POOLER connection string from Supabase (Connect button,
# port 5432) — not the direct connection, which is IPv6-only on free tier
# and will fail with ENETUNREACH from most local/free-tier networks.
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-1-yourregion.pooler.supabase.com:5432/postgres
NODE_ENV=development
PORT=3000
