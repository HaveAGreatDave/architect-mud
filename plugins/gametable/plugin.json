{
  "name": "gametable",
  "description": "Multiplayer card game tables. Texas Hold'em is the first game; framework supports future expansion.",
  "version": "1.0.0",
  "after": ["broadcast", "interactions"],
  "hooks": ["zone.furniturePanel"],
  "routePrefix": "/gametable",
  "commands": [
    "join", "seat", "leave", "spectate", "watch", "say", "look", "help",
    "check", "call", "deal", "summon", "calldealer", "bet", "raise", "fold", "allin",
    "table", "board", "pot", "players", "showhand"
  ]
}
