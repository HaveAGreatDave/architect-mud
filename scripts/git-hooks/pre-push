#!/bin/sh
# Pre-push gate. Two jobs, in order:
#
#   1. Regression gate — if the push contains any CODE change, run the full
#      regress suite and BLOCK the push if it's red. Content-only pushes (just
#      db/seed.sql) skip it — that's the World lane, and regress can't tell you
#      anything about a seed dump. This gate fires no matter how you push
#      (terminal, IDE) and can never race a second tool mutating the working tree.
#      Bypass in a genuine emergency with:  git push --no-verify
#
#   2. Dev Log sync — the deployed host has a shallow clone and can't rebuild the
#      commit history, so we sync it from this full clone first. Best-effort; a
#      DB outage never blocks the push.
#
# Enabled via core.hooksPath scripts/git-hooks (run: npm run hooks:install).

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# All-zeros object id (a deleted or brand-new ref). Works for SHA-1 and SHA-256.
is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

# --- 1. Regression gate ------------------------------------------------------
# Read the refs git is about to push (stdin: <lref> <loid> <rref> <roid>) and
# decide whether any non-seed file is going out. Read directly (no pipe) so the
# flag survives the loop.
needs_regress=0
needs_lint=0
deleted_content=""
push_oids=""
while read -r local_ref local_oid remote_ref remote_oid; do
  is_zero "$local_oid" && continue          # branch deletion — nothing to gate
  push_oids="$push_oids $local_oid"          # what imports:smoke --ref checks (below)
  if is_zero "$remote_oid"; then
    needs_regress=1                          # new branch on remote — gate to be safe
    continue
  fi
  changed=$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null)
  # Content-only pushes (content/ files, or the legacy seed dumps) skip the local
  # regress — CI regresses the merged main before anything reaches prod — but
  # content files always get linted (cheap, and blocks broken JSON / dangling
  # FKs from ever reaching the shared history).
  printf '%s\n' "$changed" | grep -q '^content/' && needs_lint=1
  other=$(printf '%s\n' "$changed" | grep -v '^db/seed\.sql$' | grep -v '^db/audio-seed\.sql$' | grep -v '^content/' | grep -v '^$')
  [ -n "$other" ] && needs_regress=1
  # Content-file DELETIONS get an extra safety check (below): they're the only
  # destructive content op and the one that silently wiped a teammate's work.
  del=$(git diff --name-only --diff-filter=D --no-renames "$remote_oid" "$local_oid" 2>/dev/null | grep '^content/')
  [ -n "$del" ] && deleted_content="$deleted_content$del
"
done

# --- Content deletion guard --------------------------------------------------
# Block a push that deletes content files your local DB never imported — the
# fingerprint of `content:export` run against a stale DB (see the script header).
if [ -n "$deleted_content" ]; then
  echo "[content-guard] this push deletes content files — verifying against your import marker…"
  if printf '%s' "$deleted_content" | node scripts/content/guard-deletions.mjs; then
    :
  else
    exit 1
  fi
fi

if [ "$needs_lint" = 1 ]; then
  echo "[content-gate] content files in this push — linting…"
  if node scripts/content/lint.mjs </dev/null; then
    echo "[content-gate] lint clean."
  else
    echo ""
    echo "✗ [content-gate] content:lint FAILED — push BLOCKED."
    echo "  Fix the files (or re-export from your DB), then push again."
    exit 1
  fi
fi

if [ "$needs_regress" = 1 ]; then
  # ── ⚠ CHECK THE COMMIT, NOT THE WORKING TREE ───────────────────────────────
  # Everything below this gates the files on disk, which is NOT what is about to
  # be pushed. On 2026-09-01 a commit went out importing `drugForItem` while the
  # export sat uncommitted in the tree: the full suite passed 8988/8988 here and
  # CI could not load the plugin at all, because ESM resolves named imports at
  # link time. Surveillance owns eight verbs, so the failure surfaced as unrelated
  # help-text checks and every content deploy stopped.
  #
  # `pretest:regress` runs this same script over the working tree; this run is the
  # other half, and it is the only thing in the gate that reads the actual commit.
  # It checks out a detached worktree per oid, so it costs a few seconds.
  for oid in $push_oids; do
    if ! node scripts/imports/smoke.mjs --ref "$oid" </dev/null; then
      echo ""
      echo "✗ [imports-gate] a commit in this push has an import nothing exports — push BLOCKED."
      echo "  Usually this means half a change is committed: the caller went out,"
      echo "  the export it needs is still sitting in your working tree."
      echo "  (Real emergency only:  git push --no-verify)"
      exit 1
    fi
  done

  echo "[regress-gate] code changes in this push — running regression gate…"
  node scripts/kill-orphans.js >/dev/null 2>&1   # sweep orphaned pool connections first (pretest sweeps too; this is cheap insurance before a gate that has died on the pool)
  # ── ⚠ THE NPM SCRIPT, NOT ONE OF ITS FILES ─────────────────────────────────
  # This ran `node tests/regress.js` directly, which meant the PUSH gate and the
  # TEST gate were two different gates that everybody described with the same
  # sentence — "regress runs". Everything in `pretest:regress` was outside the
  # push: parse-smoke, automation-smoke, content:lint, query-lint, docs:lint and
  # every scripts/shapes smoke. A client file that did not parse, a doc link that
  # did not resolve, or a building model that threw could all be pushed by a
  # developer who had never typed `npm run test:regress` by hand, and the hook
  # would print "regress green" on the way out.
  #
  # This is the same shape as the docs:lint bug recorded in CLAUDE.md — the gate
  # invoked one of the script's FILES rather than the script, so the other two
  # checks were never gated at all and a real gap sat behind the wording for
  # months. Same fix: invoke the npm script, so there is ONE definition of what
  # the gate is and adding a check to it picks it up here for free.
  #
  # ⚠ KEEP `</dev/null`. The hook's own stdin is the ref list git fed it, and
  # anything the chain spawns must not inherit what is left of it.
  if npm run test:regress </dev/null; then
    echo "[regress-gate] regress green — push allowed."
  else
    echo ""
    # ⚠ NOT "the regression suite failed". The gate is the whole pretest chain
    # plus the suite, and on 2026-08-21 it printed exactly that while the suite
    # had passed 8349/8349 — the run had been killed a sixth of the way in. A
    # gate that names the wrong culprit sends you to debug the wrong thing.
    echo "✗ [regress-gate] Pre-push gate FAILED — push BLOCKED."
    echo "  That is 'npm run test:regress': the pretest chain (parse/automation"
    echo "  smokes, content + query + docs lint, shapes smokes) AND the suite."
    echo "  Scroll up for which one — the suite prints a trailing 'N/N passed'."
    echo "  (Real emergency only:  git push --no-verify)"
    exit 1
  fi
else
  echo "[regress-gate] content-only push — regress skipped (CI regresses main)."
fi

# --- 2. Dev Log commit-history sync (best-effort) ----------------------------
echo "[dev-log] syncing commit history before push…"
if node scripts/sync-commits.js >/dev/null 2>&1; then
  echo "[dev-log] commit history synced."
else
  echo "[dev-log] sync skipped (DB unreachable) — push/deploy continues."
fi

exit 0
